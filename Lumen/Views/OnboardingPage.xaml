<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Lumen.Views.OnboardingPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lumen.ViewModels"
             x:DataType="vm:OnboardingViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#140B38" Offset="0" />
            <GradientStop Color="#3B1F9E" Offset="0.55" />
            <GradientStop Color="#0E7490" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="24,20,24,32" RowSpacing="18">

        <!-- Top bar -->
        <Grid ColumnDefinitions="*,Auto">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Border WidthRequest="30" HeightRequest="30" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="#33FFFFFF">
                    <Label Text="L" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Lumen" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Grid.Column="1"
                   Text="Skip"
                   TextColor="#CCFFFFFF"
                   FontAttributes="Bold"
                   Padding="12,6"
                   VerticalOptions="Center"
                   IsVisible="{Binding IsNotLastSlide}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SkipCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- Slides -->
        <CarouselView Grid.Row="1"
                      ItemsSource="{Binding Slides}"
                      Position="{Binding Position, Mode=TwoWay}"
                      IndicatorView="{x:Reference Indicator}"
                      Loop="False"
                      HorizontalScrollBarVisibility="Never">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="vm:OnboardingSlide">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="26" Padding="6,0">
                        <Grid HorizontalOptions="Center" WidthRequest="210" HeightRequest="210">
                            <Ellipse Fill="#14FFFFFF" WidthRequest="210" HeightRequest="210" />
                            <Ellipse Fill="#1FFFFFFF" WidthRequest="160" HeightRequest="160"
                                     HorizontalOptions="Center" VerticalOptions="Center" />
                            <Ellipse Fill="#2EFFFFFF" WidthRequest="112" HeightRequest="112"
                                     HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Text="{Binding Emoji}" FontSize="60"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding Title}"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Subtitle}"
                               FontSize="16"
                               TextColor="#D9FFFFFF"
                               LineHeight="1.3"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Indicator + name -->
        <VerticalStackLayout Grid.Row="2" Spacing="18">
            <IndicatorView x:Name="Indicator"
                           IndicatorColor="#55FFFFFF"
                           SelectedIndicatorColor="White"
                           IndicatorSize="9"
                           HorizontalOptions="Center" />

            <Border IsVisible="{Binding IsLastSlide}"
                    StrokeThickness="1"
                    Stroke="#44FFFFFF"
                    BackgroundColor="#1FFFFFFF"
                    StrokeShape="RoundRectangle 18"
                    Padding="16,2">
                <Entry Text="{Binding Name}"
                       Placeholder="What should we call you?"
                       PlaceholderColor="#B3FFFFFF"
                       TextColor="White"
                       ReturnCommand="{Binding NextCommand}" />
            </Border>
        </VerticalStackLayout>

        <!-- CTA -->
        <Button Grid.Row="3"
                Text="{Binding NextText}"
                Command="{Binding NextCommand}"
                BackgroundColor="White"
                TextColor="#3B1F9E"
                HeightRequest="58"
                CornerRadius="20"
                FontSize="16" />
    </Grid>
</ContentPage>
