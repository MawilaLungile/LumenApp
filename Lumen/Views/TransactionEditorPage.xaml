<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Lumen.Views.TransactionEditorPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lumen.ViewModels"
             x:DataType="vm:TransactionEditorViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ================= Top bar ================= -->
        <Grid Padding="16,14,16,6" ColumnDefinitions="44,*,44">
            <Border Style="{StaticResource IconButton}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseCommand}" />
                </Border.GestureRecognizers>
                <Label Text="✕" FontSize="16" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Grid.Column="1" Text="{Binding PageTitle}" Style="{StaticResource H3}"
                   HorizontalOptions="Center" VerticalOptions="Center" />

            <Border Grid.Column="2" Style="{StaticResource IconButton}" IsVisible="{Binding CanDelete}"
                    BackgroundColor="#1AFF5C7A">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                </Border.GestureRecognizers>
                <Label Text="🗑" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,24" Spacing="22">

                <!-- ================= Expense / Income switch ================= -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface2Light}, Dark={StaticResource Surface2Dark}}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="5">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="0,12" BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsExpense}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetTypeCommand}" CommandParameter="expense" />
                            </Border.GestureRecognizers>
                            <Label Text="↑  Expense" FontAttributes="Bold" HorizontalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>

                        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="0,12" BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsIncome}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Success}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetTypeCommand}" CommandParameter="income" />
                            </Border.GestureRecognizers>
                            <Label Text="↓  Income" FontAttributes="Bold" HorizontalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= Amount ================= -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="AMOUNT" Style="{StaticResource SectionTitle}" HorizontalOptions="Center" Margin="0" />
                    <Grid ColumnDefinitions="*,Auto,Auto,*" HorizontalOptions="Fill">
                        <Label Grid.Column="1" Text="{Binding CurrencySymbol}" FontSize="34" FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}" />
                        <Entry Grid.Column="2"
                               x:Name="AmountEntry"
                               Text="{Binding AmountText}"
                               Placeholder="0.00"
                               Keyboard="Numeric"
                               FontSize="46"
                               FontAttributes="Bold"
                               WidthRequest="230"
                               HorizontalTextAlignment="Center" />
                    </Grid>
                </VerticalStackLayout>

                <!-- ================= Details ================= -->
                <Border Style="{StaticResource Card}" Padding="16,4">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="30,*" ColumnSpacing="8">
                            <Label Text="✏️" FontSize="16" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding Title}" Placeholder="Title (e.g. Groceries)" MaxLength="120" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="30,*" ColumnSpacing="8">
                            <Label Text="📝" FontSize="16" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding Note}" Placeholder="Add a note (optional)" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="8">
                            <Label Text="📅" FontSize="16" VerticalOptions="Center" />
                            <DatePicker Grid.Column="1" Date="{Binding Date}" Format="ddd, dd MMM yyyy" />
                            <TimePicker Grid.Column="2" Time="{Binding Time}" Format="HH:mm" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ================= Category ================= -->
                <Label Text="CATEGORY" Style="{StaticResource SectionTitle}" Margin="6,0,0,-12" />
                <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start"
                            BindableLayout.ItemsSource="{Binding CategoryChoices}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryChoice">
                            <ContentView FlexLayout.Basis="25%" Padding="4">
                                <Border StrokeThickness="2"
                                        Stroke="{Binding TileStroke}"
                                        BackgroundColor="{Binding TileColor}"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="2,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCategoryTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="6">
                                        <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 23"
                                                BackgroundColor="{Binding Category.SoftColor}"
                                                HorizontalOptions="Center">
                                            <Label Text="{Binding Category.Icon}" FontSize="22"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Text="{Binding Category.ShortName}" FontSize="11"
                                               HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                            </ContentView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= Save ================= -->
        <Button Grid.Row="2"
                Text="{Binding SaveText}"
                Command="{Binding SaveCommand}"
                Margin="20,8,20,20"
                HeightRequest="58"
                CornerRadius="20"
                FontSize="16"
                TextColor="White">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#8B6CFF" Offset="0" />
                    <GradientStop Color="#00B4D8" Offset="1" />
                </LinearGradientBrush>
            </Button.Background>
            <Button.Shadow>
                <Shadow Brush="#7C5CFF" Opacity="0.35" Radius="18" Offset="0,8" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>
