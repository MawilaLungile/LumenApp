<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Lumen.Views.GoalsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lumen.ViewModels"
             xmlns:m="clr-namespace:Lumen.Models"
             xmlns:charts="clr-namespace:Lumen.Charts"
             x:DataType="vm:GoalsViewModel"
             Shell.NavBarIsVisible="False">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <CollectionView ItemsSource="{Binding Goals}" SelectionMode="None" Margin="14,0">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" />
            </CollectionView.ItemsLayout>

            <!-- ================= Header ================= -->
            <CollectionView.Header>
                <VerticalStackLayout Padding="6,18,6,6" Spacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Goals" Style="{StaticResource H1}" />
                            <Label Text="{Binding CompletedText}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource IconButtonPrimary}" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="+" TextColor="White" FontSize="24" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,0,2" />
                        </Border>
                    </Grid>

                    <!-- Total saved hero card -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 26" Padding="22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0EA5A4" Offset="0" />
                                <GradientStop Color="#0E7490" Offset="0.55" />
                                <GradientStop Color="#5B3FE0" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#0E7490" Opacity="0.35" Radius="24" Offset="0,10" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,96" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Total saved" TextColor="#E6FFFFFF" />
                                <Label Text="{Binding TotalSavedText}" TextColor="White" FontSize="30" FontAttributes="Bold" />
                                <Label Text="{Binding TotalTargetText}" TextColor="#D9FFFFFF" FontSize="12" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" WidthRequest="96" HeightRequest="96">
                                <charts:ProgressRingView Value="{Binding OverallProgress}"
                                                         RingColor="White"
                                                         TrackColor="#33FFFFFF"
                                                         RingThickness="10" />
                                <Label Text="{Binding OverallPercentText}" TextColor="White" FontAttributes="Bold" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Label Text="YOUR GOALS" Style="{StaticResource SectionTitle}" Margin="6,4,0,-8" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ================= Goal cards ================= -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:SavingsGoal">
                    <ContentView Padding="6">
                        <Border Style="{StaticResource Card}" Padding="14,18">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGoalTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <Grid WidthRequest="96" HeightRequest="96" HorizontalOptions="Center">
                                    <charts:ProgressRingView Value="{Binding Progress}"
                                                             RingColor="{Binding Color}"
                                                             TrackColor="{Binding SoftColor}"
                                                             RingThickness="9" />
                                    <Label Text="{Binding Icon}" FontSize="30"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14"
                                       HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" Margin="0,4,0,0" />
                                <Label Text="{Binding SavedText}" FontAttributes="Bold" FontSize="18"
                                       TextColor="{Binding Color}" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding TargetText}" Style="{StaticResource Caption}" FontSize="11"
                                       HorizontalTextAlignment="Center" />
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,4"
                                        HorizontalOptions="Center" BackgroundColor="{Binding SoftColor}">
                                    <Label Text="{Binding DeadlineText}" FontSize="11" FontAttributes="Bold" />
                                </Border>
                                <Label Text="{Binding MonthlyNeededText}" Style="{StaticResource Caption}" FontSize="10"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40,40" Spacing="8" HorizontalOptions="Center">
                    <Label Text="🌱" FontSize="44" HorizontalOptions="Center" />
                    <Label Text="Plant your first goal" Style="{StaticResource H3}" HorizontalOptions="Center" />
                    <Label Text="Tap + to start saving for something you love."
                           Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="30" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
