<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Lumen.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lumen.ViewModels"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,40" Spacing="18">

            <Label Text="Settings" Style="{StaticResource H1}" />

            <!-- ================= Profile hero ================= -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 26" Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8B6CFF" Offset="0" />
                        <GradientStop Color="#5B3FE0" Offset="0.6" />
                        <GradientStop Color="#F472B6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#7C5CFF" Opacity="0.3" Radius="22" Offset="0,10" />
                </Border.Shadow>
                <Grid ColumnDefinitions="64,*" ColumnSpacing="16">
                    <Border WidthRequest="64" HeightRequest="64" StrokeThickness="2" Stroke="#66FFFFFF"
                            StrokeShape="RoundRectangle 32" BackgroundColor="#33FFFFFF">
                        <Label Text="{Binding Initials}" TextColor="White" FontSize="22" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding UserName}" TextColor="White" FontSize="21" FontAttributes="Bold"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding StatsText}" TextColor="#E0FFFFFF" FontSize="13" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ================= Profile ================= -->
            <Label Text="PROFILE" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="16,2">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="👤   Display name" VerticalOptions="Center" FontSize="15" />
                    <Entry Grid.Column="1" Text="{Binding UserName}" HorizontalTextAlignment="End" MaxLength="40"
                           Placeholder="Your name" />
                </Grid>
            </Border>

            <!-- ================= Appearance ================= -->
            <Label Text="APPEARANCE" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="16,2">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="🎨   Theme" VerticalOptions="Center" FontSize="15" />
                        <Picker Grid.Column="1" ItemsSource="{Binding Themes}" SelectedIndex="{Binding ThemeIndex}"
                                WidthRequest="120" HorizontalTextAlignment="End" Title="Theme" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="💱   Currency symbol" VerticalOptions="Center" FontSize="15" />
                        <Picker Grid.Column="1" ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}"
                                WidthRequest="120" HorizontalTextAlignment="End" Title="Currency" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ================= Data ================= -->
            <Label Text="DATA" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid Padding="16,14" ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ExportCsvCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource IconButton}" WidthRequest="40" HeightRequest="40" BackgroundColor="#1A00B4D8">
                            <Label Text="📤" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Export to CSV" FontAttributes="Bold" />
                            <Label Text="Share your transactions with Excel or Sheets" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" Margin="16,0" />
                    <Grid Padding="16,14" ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ReloadDemoCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource IconButton}" WidthRequest="40" HeightRequest="40" BackgroundColor="#1A7C5CFF">
                            <Label Text="✨" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Reload demo data" FontAttributes="Bold" />
                            <Label Text="Regenerate 2½ months of sample activity" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" Margin="16,0" />
                    <Grid Padding="16,14" ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EraseAllCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource IconButton}" WidthRequest="40" HeightRequest="40" BackgroundColor="#1AFF5C7A">
                            <Label Text="🗑" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Erase all data" FontAttributes="Bold" TextColor="{StaticResource Danger}" />
                            <Label Text="Start fresh with an empty wallet" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ================= About ================= -->
            <Label Text="ABOUT" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid Padding="16,14" ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ReplayOnboardingCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource IconButton}" WidthRequest="40" HeightRequest="40" BackgroundColor="#1AFFB547">
                            <Label Text="🎬" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Replay onboarding" FontAttributes="Bold" />
                            <Label Text="See the welcome tour again" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" Margin="16,0" />
                    <VerticalStackLayout Padding="16,16" Spacing="4">
                        <Label Text="Lumen" FontAttributes="Bold" FontSize="16" />
                        <Label Text="{Binding AppVersion}" Style="{StaticResource Caption}" FontSize="12" />
                        <Label Text="{Binding PlatformText}" Style="{StaticResource Caption}" FontSize="12" />
                        <Label Text="Built with .NET MAUI · MVVM Toolkit · SQLite · Microsoft.Maui.Graphics"
                               Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0" />
                        <Label Text="🔒 100% offline — your data never leaves this device."
                               Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
