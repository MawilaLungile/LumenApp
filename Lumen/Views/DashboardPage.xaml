<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Lumen.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lumen.ViewModels"
             xmlns:m="clr-namespace:Lumen.Models"
             xmlns:charts="clr-namespace:Lumen.Charts"
             xmlns:components="clr-namespace:Lumen.Views.Components"
             x:DataType="vm:DashboardViewModel"
             Shell.NavBarIsVisible="False">

    <Grid>
        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="20,18,20,110" Spacing="20">

                    <!-- ================= Header ================= -->
                    <Grid x:Name="Header" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Greeting}" Style="{StaticResource Caption}" FontSize="14" />
                            <Label Text="{Binding UserName}" Style="{StaticResource H1}" FontSize="26" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                WidthRequest="48" HeightRequest="48"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 24">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF8A65" Offset="0" />
                                    <GradientStop Color="#F472B6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Label Text="{Binding Initials}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="17"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- ================= Balance card ================= -->
                    <Border x:Name="BalanceCard"
                            StrokeThickness="0"
                            Padding="22"
                            StrokeShape="RoundRectangle 28">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B6CFF" Offset="0" />
                                <GradientStop Color="#5B3FE0" Offset="0.5" />
                                <GradientStop Color="#00A6D6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#7C5CFF" Opacity="0.35" Radius="26" Offset="0,12" />
                        </Border.Shadow>

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                            <!-- decorative circles -->
                            <Ellipse Grid.RowSpan="4" Fill="#14FFFFFF" WidthRequest="190" HeightRequest="190"
                                     HorizontalOptions="End" VerticalOptions="Start" Margin="0,-90,-90,0" />
                            <Ellipse Grid.RowSpan="4" Fill="#0FFFFFFF" WidthRequest="120" HeightRequest="120"
                                     HorizontalOptions="End" VerticalOptions="End" Margin="0,0,30,-70" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Total balance" TextColor="#E6FFFFFF" FontSize="14" />
                                <Border Grid.Column="1" BackgroundColor="#26FFFFFF" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10" Padding="10,3">
                                    <Label Text="{Binding MonthLabel}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </Grid>

                            <Label Grid.Row="1" Text="{Binding Balance}" FontSize="36" FontAttributes="Bold" TextColor="White" />
                            <Label Grid.Row="2" Text="{Binding SavingsRateText}" FontSize="12" TextColor="#E6FFFFFF" />

                            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,14,0,0">
                                <!-- Income -->
                                <Border BackgroundColor="#24FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="12">
                                    <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                                        <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 17" BackgroundColor="#33FFFFFF">
                                            <Label Text="↓" TextColor="#7CFFC4" FontSize="18" FontAttributes="Bold"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="Income" TextColor="#D9FFFFFF" FontSize="11" />
                                            <Label Text="{Binding MonthIncome}" TextColor="White" FontSize="14"
                                                   FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                                <!-- Expense -->
                                <Border Grid.Column="1" BackgroundColor="#24FFFFFF" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 18" Padding="12">
                                    <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                                        <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 17" BackgroundColor="#33FFFFFF">
                                            <Label Text="↑" TextColor="#FFB3C1" FontSize="18" FontAttributes="Bold"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="Expenses" TextColor="#D9FFFFFF" FontSize="11" />
                                            <Label Text="{Binding MonthExpense}" TextColor="White" FontSize="14"
                                                   FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ================= Insight ================= -->
                    <Border x:Name="InsightCard" Style="{StaticResource Card}" Padding="16">
                        <Grid ColumnDefinitions="44,*" ColumnSpacing="14">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}">
                                <Label Text="{Binding InsightEmoji}" FontSize="20"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Weekly insight" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding Insight}" FontSize="13" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- ================= Weekly chart ================= -->
                    <Border x:Name="WeekCard" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="Last 7 days" Style="{StaticResource H3}" />
                                    <Label Text="Daily spending" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding WeekTotal}" FontAttributes="Bold" FontSize="16"
                                       VerticalOptions="Center" />
                            </Grid>
                            <charts:BarChartView HeightRequest="190"
                                                 Values="{Binding WeeklyValues}"
                                                 Labels="{Binding WeeklyLabels}"
                                                 BarColor="{StaticResource Primary}"
                                                 HighlightColor="{StaticResource Accent}"
                                                 TrackColor="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}"
                                                 TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- ================= Category breakdown ================= -->
                    <Border x:Name="CategoryCard" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="16">
                            <VerticalStackLayout>
                                <Label Text="Where your money went" Style="{StaticResource H3}" />
                                <Label Text="{Binding MonthLabel}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="140,*" ColumnSpacing="18" IsVisible="{Binding HasCategoryData}">
                                <charts:DonutChartView WidthRequest="140" HeightRequest="140"
                                                       VerticalOptions="Center"
                                                       Slices="{Binding CategorySlices}"
                                                       RingThickness="16"
                                                       CenterText="{Binding MonthExpense}"
                                                       CenterSubText="spent"
                                                       TrackColor="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"
                                                       SubTextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}" />

                                <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center"
                                                     BindableLayout.ItemsSource="{Binding TopCategories}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="m:CategorySpend">
                                            <Grid ColumnDefinitions="12,*,Auto" ColumnSpacing="8">
                                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                                         Color="{Binding Category.Color}" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding Category.ShortName}" FontSize="13"
                                                       LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                                <Label Grid.Column="2" Text="{Binding ShareText}" FontSize="13"
                                                       FontAttributes="Bold" VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Grid>

                            <Label Text="No spending recorded this month yet."
                                   Style="{StaticResource Caption}"
                                   IsVisible="{Binding HasNoCategoryData}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- ================= Recent ================= -->
                    <VerticalStackLayout x:Name="RecentSection" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Recent activity" Style="{StaticResource H3}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="See all →" Style="{StaticResource Link}" Padding="8,4">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SeeAllCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding RecentTransactions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:TransactionEntry">
                                    <components:TransactionRow />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoRecent}" Padding="24">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="🪄" FontSize="34" HorizontalOptions="Center" />
                                <Label Text="No transactions yet" Style="{StaticResource H3}" HorizontalOptions="Center" />
                                <Label Text="Tap + to add your first one." Style="{StaticResource Caption}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- ================= Floating action button ================= -->
        <Border x:Name="Fab"
                WidthRequest="62" HeightRequest="62"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 31"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,22,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#8B6CFF" Offset="0" />
                    <GradientStop Color="#00B4D8" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <Shadow Brush="#7C5CFF" Opacity="0.5" Radius="20" Offset="0,8" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AddTransactionCommand}" />
            </Border.GestureRecognizers>
            <Label Text="+" TextColor="White" FontSize="32" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,0,3" />
        </Border>
    </Grid>
</ContentPage>
