<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Lumen.Views.BudgetsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lumen.ViewModels"
             xmlns:charts="clr-namespace:Lumen.Charts"
             x:DataType="vm:BudgetsViewModel"
             Shell.NavBarIsVisible="False">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" Margin="14,0">

            <!-- ================= Header ================= -->
            <CollectionView.Header>
                <VerticalStackLayout Padding="6,18,6,6" Spacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Budgets" Style="{StaticResource H1}" />
                            <Label Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource IconButtonPrimary}" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="+" TextColor="White" FontSize="24" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,0,2" />
                        </Border>
                    </Grid>

                    <!-- Overview -->
                    <Border Style="{StaticResource Card}" Padding="20">
                        <Grid ColumnDefinitions="124,*" ColumnSpacing="20">
                            <Grid WidthRequest="124" HeightRequest="124">
                                <charts:ProgressRingView Value="{Binding OverallProgress}"
                                                         RingColor="{StaticResource Primary}"
                                                         TrackColor="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}"
                                                         RingThickness="13" />
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="{Binding OverallPercentText}" FontSize="24" FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                    <Label Text="used" Style="{StaticResource Caption}" FontSize="11" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="Spent this month" Style="{StaticResource Caption}" />
                                <Label Text="{Binding TotalSpentText}" FontSize="24" FontAttributes="Bold" />
                                <Label Text="{Binding TotalLimitText}" Style="{StaticResource Caption}" FontSize="12" />
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,5"
                                        Margin="0,8,0,0" HorizontalOptions="Start" BackgroundColor="#1A22C55E">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsOverBudget}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#1AFF5C7A" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding RemainingText}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource Success}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsOverBudget}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Label Text="BY CATEGORY" Style="{StaticResource SectionTitle}" Margin="6,4,0,-8" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ================= Items ================= -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:BudgetItem">
                    <ContentView Padding="6">
                        <Border Style="{StaticResource Card}" Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBudgetTapped" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14"
                                            BackgroundColor="{Binding Category.SoftColor}">
                                        <Label Text="{Binding Category.Icon}" FontSize="20"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label Text="{Binding Category.Name}" FontAttributes="Bold" FontSize="15" />
                                        <Label Text="{Binding SpentText}" Style="{StaticResource Caption}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding PercentText}" FontSize="17" FontAttributes="Bold"
                                           TextColor="{Binding StatusColor}" VerticalOptions="Center" />
                                </Grid>

                                <charts:LinearProgressView Grid.Row="1"
                                                           HeightRequest="10"
                                                           Value="{Binding Progress}"
                                                           BarColor="{Binding StatusColor}"
                                                           TrackColor="{Binding Category.SoftColor}" />

                                <Label Grid.Row="2" Text="{Binding LeftText}" Style="{StaticResource Caption}" FontSize="12" />
                            </Grid>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40,40" Spacing="8" HorizontalOptions="Center">
                    <Label Text="🧾" FontSize="44" HorizontalOptions="Center" />
                    <Label Text="No budgets yet" Style="{StaticResource H3}" HorizontalOptions="Center" />
                    <Label Text="Tap + to set a monthly limit for a category."
                           Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="30" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
