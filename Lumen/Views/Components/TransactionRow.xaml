<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Lumen.Views.Components.TransactionRow"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:Lumen.Models"
             x:DataType="m:TransactionEntry">

    <Border x:Name="Card" Style="{StaticResource Card}" Padding="14,12">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14">
            <Border WidthRequest="48"
                    HeightRequest="48"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{Binding Category.SoftColor}">
                <Label Text="{Binding Category.Icon}"
                       FontSize="22"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="{Binding Title}"
                       FontSize="15"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding Subtitle}"
                       Style="{StaticResource Caption}"
                       FontSize="12"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <Label Grid.Column="2"
                   Text="{Binding AmountDisplay}"
                   FontSize="15"
                   FontAttributes="Bold"
                   VerticalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Success}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </Grid>
    </Border>
</ContentView>
